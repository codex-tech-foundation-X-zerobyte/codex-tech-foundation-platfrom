VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Public contact details shown on /contact. Leave unset to show "Not yet configured"
# rather than inventing a placeholder address.
VITE_CONTACT_EMAIL=
VITE_CONTACT_WHATSAPP_URL=

# Server-side only (configure in Supabase Edge Functions, never as VITE_*):
# SUPABASE_SERVICE_ROLE_KEY=
# WHATSAPP_NUMBER=

# Voice/video calls: STUN alone connects most networks but NOT symmetric NATs or strict corporate firewalls.
# For those, calls need a TURN relay. Optional; leave unset to use STUN only.
# Comma-separate several URLs, e.g. turn:turn.example.com:3478,turns:turn.example.com:5349
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=
