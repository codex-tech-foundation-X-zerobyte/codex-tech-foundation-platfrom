# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Environment files — the *.local rule above already catches .env.local
# (what the README tells you to create), but this is explicit on purpose:
# real Supabase keys must never reach git history. .env.example stays
# tracked — it has no real secrets, only placeholder names.
.env
.env.local
.env.*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
